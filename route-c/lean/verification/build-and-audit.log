StrongEdgeRouteC.circulant913_all_edges_strong_clique :
  (StrongEdge.conflictGraph StrongEdgeRouteC.circulant913).IsClique Set.univ
StrongEdgeRouteC.circulant913_refutes_m_div_17 :
  (∀ (x : Fin 9), StrongEdgeRouteC.circulant913.degree x ≤ 4) ∧
    (∀ (S : Finset (Fin 9)), ¬StrongEdge.IsFiveCycleBlowupComponent StrongEdgeRouteC.circulant913 S) ∧
      ∀ (M : Finset ↑StrongEdgeRouteC.circulant913.edgeSet),
        StrongEdge.IsInducedMatching StrongEdgeRouteC.circulant913 ↑M → 17 * M.card < Finset.univ.card
StrongEdgeRouteC.circulant913_eighteen_bound_attained :
  ∃ M,
    StrongEdge.IsInducedMatching StrongEdgeRouteC.circulant913 ↑M ∧
      Finset.univ.card = 18 * M.card ∧
        ∀ (M' : Finset ↑StrongEdgeRouteC.circulant913.edgeSet),
          StrongEdge.IsInducedMatching StrongEdgeRouteC.circulant913 ↑M' → M'.card ≤ M.card
