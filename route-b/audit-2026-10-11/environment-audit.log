@StrongEdge19.prescribed_edge_bound19 : ∀ {V : Type u_1} [inst : Fintype V] [inst_1 : DecidableEq V] (G : SimpleGraph V)
  [inst_2 : DecidableRel G.Adj] [DecidableRel (StrongEdge.conflictGraph G).Adj],
  (∀ (x : V), G.degree x ≤ 4) →
    ∀ (F : Finset ↑G.edgeSet),
      F.card ≤
        19 * (SimpleGraph.induce (↑F) (StrongEdge.conflictGraph G)).indepNum + (StrongEdge.tightComponentsIn G F).card
@StrongEdge19.induced_matching_packing19_with_connected_component_count : ∀ {V : Type u_1} [inst : Fintype V]
  [inst_1 : DecidableEq V] (G : SimpleGraph V) [inst_2 : DecidableRel G.Adj]
  [DecidableRel (StrongEdge.conflictGraph G).Adj],
  (∀ (x : V), G.degree x ≤ 4) →
    ∀ (F : Finset ↑G.edgeSet),
      ∃ M ⊆ F, StrongEdge.IsInducedMatching G ↑M ∧ F.card ≤ 19 * M.card + (StrongEdge.tightComponentsIn G F).card
@StrongEdge19.zero_deficit_candidate_degree_eq_nineteen : ∀ {V : Type u_1} [inst : Fintype V] [DecidableEq V]
  (G : SimpleGraph V) [inst_2 : DecidableRel G.Adj] [inst_3 : DecidableRel (StrongEdge.conflictGraph G).Adj]
  (F : Set ↑G.edgeSet) [inst_4 : DecidablePred fun x => x ∈ F],
  (∀ (x : V), G.degree x ≤ 4) →
    ∀ (M : Finset ↑F),
      StrongEdge19.IsTertiaryOptimal (SimpleGraph.induce F (StrongEdge.conflictGraph G))
          (fun e => (StrongEdge.conflictGraph G).degree ↑e) M →
        ∀ {v : ↑F},
          v ∈ M →
            StrongEdge19.deficit (SimpleGraph.induce F (StrongEdge.conflictGraph G)) M v = 0 →
              (SimpleGraph.induce F (StrongEdge.conflictGraph G)).degree v = 19
@StrongEdge19.critical_degree_nineteen_forces_selected_twenty : ∀ {V : Type u_1} [inst : Fintype V] [DecidableEq V]
  (G : SimpleGraph V) [inst_2 : DecidableRel G.Adj] [inst_3 : DecidableRel (StrongEdge.conflictGraph G).Adj]
  (F : Set ↑G.edgeSet) [inst_4 : DecidablePred fun x => x ∈ F],
  (∀ (x : V), G.degree x ≤ 4) →
    ∀ (M : Finset ↑F),
      StrongEdge.IsOptimal (SimpleGraph.induce F (StrongEdge.conflictGraph G)) M →
        ∀ {v : ↑F},
          v ∈ M →
            StrongEdge19.deficit (SimpleGraph.induce F (StrongEdge.conflictGraph G)) M v = 0 →
              (SimpleGraph.induce F (StrongEdge.conflictGraph G)).degree v = 19 →
                ∃ T, ↑T ⊆ F ∧ T.card = 20 ∧ (StrongEdge.conflictGraph G).IsClique ↑T
@StrongEdge19.high19_nineteen_clique_extends_to_twenty : ∀ {V : Type u_1} [inst : Fintype V] [DecidableEq V]
  (G : SimpleGraph V) [inst_2 : DecidableRel G.Adj] [inst_3 : DecidableRel (StrongEdge.conflictGraph G).Adj],
  (∀ (x : V), G.degree x ≤ 4) →
    ∀ (Q : Finset ↑G.edgeSet),
      (StrongEdge.conflictGraph G).IsClique ↑Q →
        (∀ e ∈ Q, 19 ≤ (StrongEdge.conflictGraph G).degree e) →
          Q.card = 19 → ∃ T, Q ⊆ T ∧ T.card = 20 ∧ (StrongEdge.conflictGraph G).IsClique ↑T
@endpoint_matching_statement : ∀ {V : Type u_1} [inst : Fintype V] (G : SimpleGraph V),
  (∀ (x : V), G.degree x ≤ 4) →
    ∀ (F : Finset ↑G.edgeSet),
      ∃ M ⊆ F,
        (∀ e ∈ M, ∀ f ∈ M, e ≠ f → ∀ u ∈ ↑e, ∀ v ∈ ↑f, u ≠ v ∧ ¬G.Adj u v) ∧ #F ≤ 19 * #M + #(tightComponentsIn G F)
