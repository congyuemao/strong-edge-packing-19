StrongEdge19.induced_matching_packing19_with_connected_component_count.{u_1} {V : Type u_1} [Fintype V] [DecidableEq V]
  (G : SimpleGraph V) [DecidableRel G.Adj] [DecidableRel (StrongEdge.conflictGraph G).Adj]
  (hΔ : ∀ (x : V), G.degree x ≤ 4) (F : Finset ↑G.edgeSet) :
  ∃ M ⊆ F, StrongEdge.IsInducedMatching G ↑M ∧ F.card ≤ 19 * M.card + (StrongEdge.tightComponentsIn G F).card
StrongEdge19.prescribed_edge_bound19.{u_1} {V : Type u_1} [Fintype V] [DecidableEq V] (G : SimpleGraph V)
