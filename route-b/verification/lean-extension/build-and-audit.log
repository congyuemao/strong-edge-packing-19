StrongEdge19.compensation_identity.{u_1} {W : Type u_1} [Fintype W] [DecidableEq W] (H : SimpleGraph W)
  [DecidableRel H.Adj] (M : Finset W) (hM : H.IsMaximumIndepSet M) :
  2 * ↑(Fintype.card W) = 39 * ↑M.card - ∑ e ∈ M, StrongEdge19.deficit H M e - ↑(StrongEdge19.excessCoverage H M)
StrongEdge19.high20_clique_card_le_seventeen.{u_1} {V : Type u_1} [Fintype V] [DecidableEq V] (G : SimpleGraph V)
  [DecidableRel G.Adj] [DecidableRel (StrongEdge.conflictGraph G).Adj] (hΔ : ∀ (x : V), G.degree x ≤ 4)
  (Q : Finset ↑G.edgeSet) (hQ : (StrongEdge.conflictGraph G).IsClique ↑Q)
  (h20 : ∀ e ∈ Q, 20 ≤ (StrongEdge.conflictGraph G).degree e) : Q.card ≤ 17
StrongEdge19.private_subcubic_card_le_thirteen.{u_1} {V : Type u_1} [Fintype V] [DecidableEq V] (G : SimpleGraph V)
  [DecidableRel G.Adj] [DecidableRel (StrongEdge.conflictGraph G).Adj] (F : Set ↑G.edgeSet)
  [DecidablePred fun x => x ∈ F] (hΔ : ∀ (x : V), G.degree x ≤ 4) (M : Finset ↑F)
  (hM : (SimpleGraph.induce F (StrongEdge.conflictGraph G)).IsMaximumIndepSet M) {v : ↑F} (hv : v ∈ M)
  (hclosed : ∀ (f : ↑G.edgeSet), (StrongEdge.conflictGraph G).Adj (↑v) f → f ∈ F)
  (h21 : 21 ≤ (StrongEdge.conflictGraph G).degree ↑v)
  (hd :
    ∀ (x : V),
      (StrongEdge.edgeIncidences G
            (Finset.image Subtype.val
              (StrongEdge.privateFinset (SimpleGraph.induce F (StrongEdge.conflictGraph G)) M v))
            x).card ≤
        3) :
  (StrongEdge.privateFinset (SimpleGraph.induce F (StrongEdge.conflictGraph G)) M v).card ≤ 13
StrongEdge19.zero_deficit_candidate_degree_eq_nineteen.{u_1} {V : Type u_1} [Fintype V] [DecidableEq V]
  (G : SimpleGraph V) [DecidableRel G.Adj] [DecidableRel (StrongEdge.conflictGraph G).Adj] (F : Set ↑G.edgeSet)
  [DecidablePred fun x => x ∈ F] (hΔ : ∀ (x : V), G.degree x ≤ 4) (M : Finset ↑F)
  (hM :
    StrongEdge19.IsTertiaryOptimal (SimpleGraph.induce F (StrongEdge.conflictGraph G))
      (fun e => (StrongEdge.conflictGraph G).degree ↑e) M)
  {v : ↑F} (hv : v ∈ M) (hzero : StrongEdge19.deficit (SimpleGraph.induce F (StrongEdge.conflictGraph G)) M v = 0) :
  (SimpleGraph.induce F (StrongEdge.conflictGraph G)).degree v = 19
StrongEdge19.critical_degree_nineteen_forces_selected_twenty.{u_1} {V : Type u_1} [Fintype V] [DecidableEq V]
  (G : SimpleGraph V) [DecidableRel G.Adj] [DecidableRel (StrongEdge.conflictGraph G).Adj] (F : Set ↑G.edgeSet)
  [DecidablePred fun x => x ∈ F] (hΔ : ∀ (x : V), G.degree x ≤ 4) (M : Finset ↑F)
  (hM : StrongEdge.IsOptimal (SimpleGraph.induce F (StrongEdge.conflictGraph G)) M) {v : ↑F} (hv : v ∈ M)
  (hzero : StrongEdge19.deficit (SimpleGraph.induce F (StrongEdge.conflictGraph G)) M v = 0)
  (hd : (SimpleGraph.induce F (StrongEdge.conflictGraph G)).degree v = 19) :
  ∃ T, ↑T ⊆ F ∧ T.card = 20 ∧ (StrongEdge.conflictGraph G).IsClique ↑T
StrongEdge19.deficit_pos_of_no_twenty_clique.{u_1} {V : Type u_1} [Fintype V] [DecidableEq V] (G : SimpleGraph V)
  [DecidableRel G.Adj] [DecidableRel (StrongEdge.conflictGraph G).Adj] (F : Set ↑G.edgeSet)
  [DecidablePred fun x => x ∈ F] (hΔ : ∀ (x : V), G.degree x ≤ 4)
  (hno : ∀ (T : Finset ↑G.edgeSet), ↑T ⊆ F → (StrongEdge.conflictGraph G).IsClique ↑T → T.card ≤ 19) (M : Finset ↑F)
  (hM :
    StrongEdge19.IsTertiaryOptimal (SimpleGraph.induce F (StrongEdge.conflictGraph G))
      (fun e => (StrongEdge.conflictGraph G).degree ↑e) M)
  {v : ↑F} (hv : v ∈ M) : 1 ≤ StrongEdge19.deficit (SimpleGraph.induce F (StrongEdge.conflictGraph G)) M v
StrongEdge19.global_compensation_of_no_twenty_clique.{u_1} {V : Type u_1} [Fintype V] [DecidableEq V]
  (G : SimpleGraph V) [DecidableRel G.Adj] [DecidableRel (StrongEdge.conflictGraph G).Adj] (F : Set ↑G.edgeSet)
  [DecidablePred fun x => x ∈ F] (hΔ : ∀ (x : V), G.degree x ≤ 4)
  (hno : ∀ (T : Finset ↑G.edgeSet), ↑T ⊆ F → (StrongEdge.conflictGraph G).IsClique ↑T → T.card ≤ 19) (M : Finset ↑F)
  (hM :
    StrongEdge19.IsTertiaryOptimal (SimpleGraph.induce F (StrongEdge.conflictGraph G))
      (fun e => (StrongEdge.conflictGraph G).degree ↑e) M) :
  ↑M.card ≤
    ∑ e ∈ M, StrongEdge19.deficit (SimpleGraph.induce F (StrongEdge.conflictGraph G)) M e +
      ↑(StrongEdge19.excessCoverage (SimpleGraph.induce F (StrongEdge.conflictGraph G)) M)
StrongEdge19.induced_matching_packing19_unconditional.{u_1} {V : Type u_1} [Fintype V] [DecidableEq V]
  (G : SimpleGraph V) [DecidableRel G.Adj] [DecidableRel (StrongEdge.conflictGraph G).Adj]
  (hΔ : ∀ (x : V), G.degree x ≤ 4) (F : Finset ↑G.edgeSet) :
